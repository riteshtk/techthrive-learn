{
  "name": "techthrive-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:index": "node scripts/gen-content-index.ts",
    "check:content": "npm run content:index && tsx scripts/check-content.ts",
    "dev": "npm run content:index && next dev",
    "build": "npm run check:content && next build",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run content:index && next typegen && tsc --noEmit",
    "test": "npm run check:content && npm run typecheck && vitest run",
    "test:e2e": "playwright test --project=chromium-360 --project=chromium-1280",
    "test:e2e:webkit": "playwright test --project=webkit-360",
    "check:budget": "tsx scripts/check-js-budget.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
